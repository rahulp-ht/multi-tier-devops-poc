
import groovy.json.JsonOutput

pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        timeout(time: 150, unit: 'MINUTES')
        skipDefaultCheckout(true)
    }

    parameters {
        string(
            name: 'CI_BUILD_NUMBER',
            defaultValue: '',
            description: 'Successful upstream CI build number'
        )
        string(
            name: 'IMAGE_TAG',
            defaultValue: '',
            description: 'Unique CI image tag: COMMIT_SHA-BUILD_NUMBER'
        )
        string(
            name: 'BACKEND_IMAGE_ID',
            defaultValue: '',
            description: 'CI-tested backend Docker image ID'
        )
        string(
            name: 'FRONTEND_IMAGE_ID',
            defaultValue: '',
            description: 'CI-tested frontend Docker image ID'
        )
    }

    environment {
        AWS_REGION     = 'ap-south-1'
        AWS_ACCOUNT_ID = '809554586055'
        AWS_REGISTRY   = '809554586055.dkr.ecr.ap-south-1.amazonaws.com'
        ECR_PREFIX     = 'multi-tier-poc'
        ECS_CLUSTER    = 'multi-tier-poc-cluster'
        CI_JOB_NAME    = 'multi-tier-poc-ci'
        AWS_CLI_IMAGE  = 'public.ecr.aws/aws-cli/aws-cli:latest'
    }

    stages {

        stage('Checkout Deployment Scripts') {
            steps {
                checkout scm
                sh '''
                    set -eu
                    test -f scripts/cleanup-ecs-capacity.sh
                    bash -n scripts/cleanup-ecs-capacity.sh
                    echo "Cleanup script verified"
                '''
            }
        }
        // --------------------------------------------------
        // 1. VERIFY UPSTREAM CI
        // --------------------------------------------------

        stage('Verify Successful CI Build') {
            steps {
                script {
                    def ciBuildNumber =
                        (params.CI_BUILD_NUMBER ?: '').toString().trim()

                    def imageTag =
                        (params.IMAGE_TAG ?: '').toString().trim()

                    def backendImageId =
                        (params.BACKEND_IMAGE_ID ?: '').toString().trim()

                    def frontendImageId =
                        (params.FRONTEND_IMAGE_ID ?: '').toString().trim()

                    // Validate unique tag: 40-character SHA + build number
                    def validTag =
                        imageTag ==~ /^[0-9a-f]{40}-[1-9][0-9]*$/

                    def tagBuildNumber =
                        validTag ? imageTag.substring(41) : ''

                    if (!(ciBuildNumber ==~ /^[1-9][0-9]*$/) ||
                        !validTag ||
                        tagBuildNumber != ciBuildNumber ||
                        !(backendImageId ==~ /^sha256:[0-9a-f]{64}$/) ||
                        !(frontendImageId ==~ /^sha256:[0-9a-f]{64}$/)) {

                        error('Missing or invalid CI parameters; deployment refused')
                    }

                    // Verify direct trigger from upstream CI job
                    def causes = currentBuild.getBuildCauses()

                    echo "Expected CI job: ${env.CI_JOB_NAME}"
                    echo "Expected CI build: ${ciBuildNumber}"
                    echo "Detected upstream causes: ${causes}"

                    def expectedProject = env.CI_JOB_NAME.trim()

                    def fromCI = causes.any { cause ->

                        String actualProject =
                            (cause.upstreamProject ?: '').toString().trim()

                        String actualBuild =
                            (cause.upstreamBuild ?: '').toString().trim()

                        String actualJobName = actualProject ?
                            actualProject.tokenize('/').last() : ''

                        actualJobName == expectedProject &&
                        actualBuild == ciBuildNumber
                    }

                    if (!fromCI) {
                        error(
                            'CD must be triggered by the successful upstream CI build'
                        )
                    }

                    echo "CI verification PASSED"
                    echo "Deploying image: ${imageTag}"
                }

                // Verify the exact images produced by CI
                sh '''
                    set -eu

                    docker version >/dev/null

                    for SERVICE in backend frontend; do

                        SOURCE="$ECR_PREFIX/$SERVICE:$IMAGE_TAG"

                        case "$SERVICE" in
                            backend) EXPECTED="$BACKEND_IMAGE_ID" ;;
                            frontend) EXPECTED="$FRONTEND_IMAGE_ID" ;;
                        esac

                        ACTUAL="$(docker image inspect \
                            --format '{{.Id}}' "$SOURCE")" || {
                            echo "Missing CI-tested image: $SOURCE"
                            exit 1
                        }

                        if [ "$ACTUAL" != "$EXPECTED" ]; then
                            echo "Image ID mismatch: $SOURCE"
                            exit 1
                        fi

                        echo "Verified: $SOURCE"
                        echo "Image ID: $ACTUAL"

                    done
                '''
            }
        }

        // --------------------------------------------------
        // 2. PREPARE AWS CLI
        // --------------------------------------------------

        stage('Prepare AWS CLI') {
            steps {
                writeFile file: 'aws-cli.sh', text: '''#!/bin/sh
set -eu

exec docker run --rm \\
  -e AWS_ACCESS_KEY_ID \\
  -e AWS_SECRET_ACCESS_KEY \\
  -e AWS_SESSION_TOKEN \\
  -e AWS_DEFAULT_REGION="$AWS_REGION" \\
  "$AWS_CLI_IMAGE" "$@"
'''

                sh 'chmod 700 aws-cli.sh'
            }
        }

        // --------------------------------------------------
        // 3. PUSH TESTED IMAGES TO ECR
        // --------------------------------------------------

        stage('Push Tested Images to ECR') {
            steps {
                withCredentials([[
                    $class: 'AmazonWebServicesCredentialsBinding',
                    credentialsId: 'aws-ecr-credentials',
                    accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                    secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                ]]) {

                    sh '''
                        set -eu
                        set +x

                        DOCKER_CONFIG="$(mktemp -d)"
                        export DOCKER_CONFIG

                        trap 'rm -rf "$DOCKER_CONFIG"' EXIT

                        # Verify AWS account
                        ./aws-cli.sh sts get-caller-identity \\
                          --query Account --output text |
                          grep -Fx "$AWS_ACCOUNT_ID"

                        # Authenticate with ECR
                        ./aws-cli.sh ecr get-login-password \\
                          --region "$AWS_REGION" |
                          docker login \\
                            --username AWS \\
                            --password-stdin "$AWS_REGISTRY"

                        : > ecr-images.properties

                        for SERVICE in backend frontend; do

                            REPOSITORY="$ECR_PREFIX/$SERVICE"
                            SOURCE="$REPOSITORY:$IMAGE_TAG"
                            TARGET="$AWS_REGISTRY/$SOURCE"

                            case "$SERVICE" in
                                backend) EXPECTED="$BACKEND_IMAGE_ID" ;;
                                frontend) EXPECTED="$FRONTEND_IMAGE_ID" ;;
                            esac

                            # Verify repository exists
                            ./aws-cli.sh ecr describe-repositories \\
                              --repository-names "$REPOSITORY" >/dev/null

                            # Handle existing unique tags safely
                            if ./aws-cli.sh ecr describe-images \\
                                --repository-name "$REPOSITORY" \\
                                --image-ids "imageTag=$IMAGE_TAG" \\
                                >/dev/null 2>&1; then

                                echo "ECR tag already exists: $TARGET"

                                docker pull "$TARGET"

                                REMOTE_ID="$(docker image inspect \\
                                  --format '{{.Id}}' "$TARGET")"

                                if [ "$REMOTE_ID" != "$EXPECTED" ]; then
                                    echo "ECR image verification FAILED"
                                    exit 1
                                fi

                            else

                                echo "Pushing tested image: $TARGET"

                                docker tag "$SOURCE" "$TARGET"
                                docker push "$TARGET"

                            fi

                            # Retrieve immutable ECR digest
                            DIGEST="$(./aws-cli.sh ecr describe-images \\
                              --repository-name "$REPOSITORY" \\
                              --image-ids "imageTag=$IMAGE_TAG" \\
                              --query 'imageDetails[0].imageDigest' \\
                              --output text)"

                            echo "$DIGEST" |
                              grep -Eq '^sha256:[0-9a-f]{64}$'

                            # Save approved image digest
                            printf '%s=%s\\n' \\
                              "$SERVICE" \\
                              "$AWS_REGISTRY/$REPOSITORY@$DIGEST" \\
                              >> ecr-images.properties

                            echo "Approved $SERVICE digest: $DIGEST"

                        done

                        echo "All CI-tested images verified in ECR"
                    '''
                }
            }
        }
   stage('Verify and Protect ECS Baseline') {
    steps {
        withCredentials([[
            $class: 'AmazonWebServicesCredentialsBinding',
            credentialsId: 'aws-ecr-credentials',
            accessKeyVariable: 'AWS_ACCESS_KEY_ID',
            secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
        ]]) {
            sh '''
                set -eu
                ASG="multi-tier-poc-ecs-asg"

                # Let in-flight Auto Scaling launches or terminations settle.
                for attempt in $(seq 1 40); do
                    STATE="$(./aws-cli.sh autoscaling describe-auto-scaling-groups \
                      --auto-scaling-group-names "$ASG" \
                      --query 'AutoScalingGroups[0].[MinSize,DesiredCapacity,MaxSize,length(Instances),length(Instances[?LifecycleState==`InService` && HealthStatus==`Healthy`])]' \
                      --output text)"
                    set -- $STATE
                    if [ "$#" -eq 5 ] && [ "$1 $2 $3 $4 $5" = "2 2 4 2 2" ]; then
                        break
                    fi
                    echo "Waiting for two healthy Auto Scaling hosts ($attempt/40): $STATE"
                    if [ "$attempt" -eq 40 ]; then
                        echo "ERROR: Expected Min=2 Desired=2 Max=4 Count=2 Healthy=2"
                        exit 1
                    fi
                    sleep 15
                done

                # Verify one instance in each AZ
                AZS="$(./aws-cli.sh autoscaling describe-auto-scaling-groups \
                  --auto-scaling-group-names "$ASG" \
                  --query 'AutoScalingGroups[0].Instances[].AvailabilityZone' \
                  --output text | tr '\\t' '\\n' | sort)"

                EXPECTED="$(printf 'ap-south-1a\\nap-south-1b')"
                [ "$AZS" = "$EXPECTED" ] || {
                    echo "ERROR: Expected one EC2 in each AZ"
                    exit 1
                }

                # Save original ECS instances for safe cleanup
                ARNS="$(./aws-cli.sh ecs list-container-instances \
                  --cluster "$ECS_CLUSTER" \
                  --status ACTIVE \
                  --query 'containerInstanceArns[]' \
                  --output text)"

                [ -n "$ARNS" ] && [ "$ARNS" != "None" ] || exit 1

                ORIGINAL="$(./aws-cli.sh ecs describe-container-instances \
                  --cluster "$ECS_CLUSTER" \
                  --container-instances $ARNS \
                  --query 'containerInstances[?agentConnected==`true` && status==`ACTIVE`].ec2InstanceId' \
                  --output text | tr '\\t' '\\n' | sed '/^$/d' | sort -u)"
                if [ "$(printf '%s\\n' "$ORIGINAL" | grep -c '^i-')" -ne 2 ]; then
                    echo "ERROR: Expected 2 baseline ECS instances"
                    exit 1
                fi

                # Refuse to deploy unless both services are already healthy
                # and configured to start replacements before stopping old tasks.
                for SERVICE in multi-tier-poc-backend multi-tier-poc-frontend; do
                    STATE="$(./aws-cli.sh ecs describe-services \
                      --cluster "$ECS_CLUSTER" \
                      --services "$SERVICE" \
                      --query 'services[0].[status,desiredCount,runningCount,pendingCount,length(deployments),deployments[0].rolloutState,deploymentConfiguration.minimumHealthyPercent,deploymentConfiguration.maximumPercent]' \
                      --output text)"
                    set -- $STATE
                    if [ "$1" != ACTIVE ] || [ "$2" -ne 2 ] ||
                       [ "$3" -ne 2 ] || [ "$4" -ne 0 ] ||
                       [ "$5" -ne 1 ] || [ "$6" != COMPLETED ] ||
                       [ "$7" -ne 100 ] || [ "$8" -lt 200 ]; then
                        echo "ERROR: $SERVICE is not healthy or lacks zero-downtime rolling settings"
                        exit 1
                    fi

                    TG="$(./aws-cli.sh ecs describe-services \
                      --cluster "$ECS_CLUSTER" --services "$SERVICE" \
                      --query 'services[0].loadBalancers[0].targetGroupArn' \
                      --output text)"
                    [ -n "$TG" ] && [ "$TG" != None ] || exit 1
                    HEALTHY="$(./aws-cli.sh elbv2 describe-target-health \
                      --target-group-arn "$TG" \
                      --query 'length(TargetHealthDescriptions[?TargetHealth.State==`healthy`])' \
                      --output text)"
                    if [ "$HEALTHY" -lt 2 ]; then
                        echo "ERROR: $SERVICE has fewer than two healthy ALB targets"
                        exit 1
                    fi
                done

                BASELINE="ecs-baseline-ec2-${BUILD_NUMBER}.txt"
                MEMBERS="$(./aws-cli.sh autoscaling describe-auto-scaling-groups \
                  --auto-scaling-group-names "$ASG" \
                  --query 'AutoScalingGroups[0].Instances[?LifecycleState==`InService` && HealthStatus==`Healthy`].InstanceId' \
                  --output text | tr '\\t' '\\n' | sort -u)"
                if [ "$MEMBERS" != "$ORIGINAL" ]; then
                    echo "ERROR: Active ECS hosts do not match the two healthy Auto Scaling hosts"
                    exit 1
                fi

                ./aws-cli.sh autoscaling set-instance-protection \
                  --auto-scaling-group-name "$ASG" \
                  --instance-ids $ORIGINAL --protected-from-scale-in

                PROTECTED="$(./aws-cli.sh autoscaling describe-auto-scaling-groups \
                  --auto-scaling-group-names "$ASG" \
                  --query 'AutoScalingGroups[0].Instances[?ProtectedFromScaleIn==`true`].InstanceId' \
                  --output text | tr '\\t' '\\n' | sort -u)"
                if [ "$PROTECTED" != "$ORIGINAL" ]; then
                    echo "ERROR: Could not verify scale-in protection for both baseline hosts"
                    exit 1
                fi
                printf '%s\\n' "$ORIGINAL" > "$BASELINE"
                echo "Verified and protected both baseline ECS hosts"
            '''
        }
    }
}

stage('Provision Spare ECS Capacity') {
    steps {
        withCredentials([[
            $class: 'AmazonWebServicesCredentialsBinding',
            credentialsId: 'aws-ecr-credentials',
            accessKeyVariable: 'AWS_ACCESS_KEY_ID',
            secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
        ]]) {
            sh '''
                set -eu
                ASG="multi-tier-poc-ecs-asg"
                # Temporarily provision spare deployment capacity
                ./aws-cli.sh autoscaling update-auto-scaling-group \
                  --auto-scaling-group-name "$ASG" \
                  --min-size 3 \
                  --desired-capacity 3

                # Wait for ECS capacity
                for i in $(seq 1 40); do
                    ARNS="$(./aws-cli.sh ecs list-container-instances \
                      --cluster "$ECS_CLUSTER" \
                      --status ACTIVE \
                      --query 'containerInstanceArns[]' \
                      --output text)"

                    if [ -n "$ARNS" ] && [ "$ARNS" != "None" ]; then
                        READY="$(./aws-cli.sh ecs describe-container-instances \
                          --cluster "$ECS_CLUSTER" \
                          --container-instances $ARNS \
                          --query 'length(containerInstances[?agentConnected==`true` && status==`ACTIVE`])' \
                          --output text)"

                        if [ "$READY" -ge 3 ]; then
                            echo "Deployment capacity ready"
                            exit 0
                        fi
                    fi
                    sleep 15
                done

                echo "ERROR: ECS capacity not ready"
                exit 1
            '''
        }
    }
}
        // --------------------------------------------------
        // 4. DEPLOY APPROVED IMAGES TO ECS
        // --------------------------------------------------

        stage('Deploy Approved Digests to ECS') {
            steps {
                withCredentials([[
                    $class: 'AmazonWebServicesCredentialsBinding',
                    credentialsId: 'aws-ecr-credentials',
                    accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                    secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                ]]) {

                    script {

                        // Read approved ECR image digests
                        def images = [:]

                        readFile('ecr-images.properties')
                            .readLines()
                            .each { line ->

                                def pair = line.split('=', 2)

                                if (pair.size() == 2) {
                                    images[pair[0]] = pair[1]
                                }
                            }

                        // Deploy backend and frontend
                        for (String component in ['backend', 'frontend']) {
                            stage(component == 'backend' ? 'Deploy Backend to ECS' : 'Deploy Frontend to ECS') {

                            String targetImage = images[component] ?: ''

                            if (!targetImage.startsWith(
                                "${env.AWS_REGISTRY}/${env.ECR_PREFIX}/${component}@sha256:"
                            ) || !(targetImage ==~ /.*@sha256:[0-9a-f]{64}$/)) {

                                error("Invalid ECR digest for ${component}")
                            }

                            String serviceName =
                                "${env.ECR_PREFIX}-${component}"

                            echo "Deploying ECS service: ${serviceName}"
                            echo "Approved image: ${targetImage}"

                            withEnv([
                                "SERVICE_NAME=${serviceName}",
                                "TARGET_IMAGE=${targetImage}"
                            ]) {

                                // Get current ECS service
                                def serviceResult = sh(
                                    returnStdout: true,
                                    script: '''./aws-cli.sh ecs describe-services \
                                      --cluster "$ECS_CLUSTER" \
                                      --services "$SERVICE_NAME" \
                                      --output json'''
                                ).trim()

                                def serviceData = readJSON(
                                    text: serviceResult,
                                    returnPojo: true
                                )

                                if (!serviceData.services ||
                                    serviceData.services.size() != 1 ||
                                    serviceData.services[0].status != 'ACTIVE' ||
                                    (serviceData.services[0].desiredCount as int) < 1) {

                                    error(
                                        "ECS service ${serviceName} is missing, inactive, or scaled to zero"
                                    )
                                }

                                // Retrieve current task definition
                                String previousTaskArn =
                                    serviceData.services[0].taskDefinition

                                def taskJson = withEnv([
                                    "TASK_ARN=${previousTaskArn}"
                                ]) {

                                    sh(
                                        returnStdout: true,
                                        script: '''./aws-cli.sh ecs describe-task-definition \
                                          --task-definition "$TASK_ARN" \
                                          --include TAGS \
                                          --output json'''
                                    ).trim()
                                }

                                def taskResult = readJSON(
                                    text: taskJson,
                                    returnPojo: true
                                )

                                def oldTask = taskResult.taskDefinition
                                def containers = oldTask.containerDefinitions

                                // Identify application container
                                def matches = containers.findAll { c ->
                                    c.name == component ||
                                    c.name == serviceName
                                }

                                if (matches.size() != 1) {

                                    if (containers.size() == 1) {
                                        matches = [containers[0]]
                                    } else {
                                        error(
                                            "Cannot identify ${component} container"
                                        )
                                    }
                                }

                                String containerName = matches[0].name

                                if (matches[0].image == targetImage) {

                                    echo "${serviceName} already uses approved image"

                                } else {

                                    // Preserve existing ECS configuration
                                    def allowedFields = [
                                        'family',
                                        'taskRoleArn',
                                        'executionRoleArn',
                                        'networkMode',
                                        'containerDefinitions',
                                        'volumes',
                                        'placementConstraints',
                                        'requiresCompatibilities',
                                        'cpu',
                                        'memory',
                                        'pidMode',
                                        'ipcMode',
                                        'proxyConfiguration',
                                        'inferenceAccelerators',
                                        'ephemeralStorage',
                                        'runtimePlatform',
                                        'enableFaultInjection'
                                    ]

                                    def payload = [:]

                                    allowedFields.each { key ->

                                        if (oldTask.containsKey(key) &&
                                            oldTask[key] != null) {

                                            payload[key] = oldTask[key]
                                        }
                                    }

                                    if (taskResult.tags) {
                                        payload.tags = taskResult.tags
                                    }

                                    // Change only the selected image
                                    matches[0].image = targetImage

                                    def json = JsonOutput.toJson(payload)

                                    // Register new task definition
                                    String newTaskArn = withEnv([
                                        "TASK_DEF_JSON=${json}"
                                    ]) {

                                        sh(
                                            returnStdout: true,
                                            script: '''set +x
                                            ./aws-cli.sh ecs register-task-definition \
                                              --cli-input-json "$TASK_DEF_JSON" \
                                              --query 'taskDefinition.taskDefinitionArn' \
                                              --output text'''
                                        ).trim()
                                    }

                                    if (!newTaskArn.startsWith('arn:aws:ecs:')) {
                                        error(
                                            "Invalid task definition ARN: ${newTaskArn}"
                                        )
                                    }

                                    echo "Registered task definition: ${newTaskArn}"

                                    // Update ECS service
                                    withEnv([
                                        "NEW_TASK_ARN=${newTaskArn}"
                                    ]) {

                                        sh '''./aws-cli.sh ecs update-service \
                                          --cluster "$ECS_CLUSTER" \
                                          --service "$SERVICE_NAME" \
                                          --task-definition "$NEW_TASK_ARN" \
                                          --query 'service.taskDefinition' \
                                          --output text'''
                                    }
                                }

// Wait up to 25 minutes for ECS deployment stability
echo "Waiting for ECS service stability..."

sh '''
    set -eu

    for attempt in $(seq 1 75); do
        STATE="$(./aws-cli.sh ecs describe-services \
          --cluster "$ECS_CLUSTER" \
          --services "$SERVICE_NAME" \
          --query 'services[0].[status,desiredCount,runningCount,pendingCount,length(deployments),deployments[0].rolloutState]' \
          --output text)"

        echo "ECS status: $STATE"
        set -- $STATE

        if [ "$1" = "ACTIVE" ] &&
           [ "$2" -gt 0 ] &&
           [ "$3" -eq "$2" ] &&
           [ "$4" -eq 0 ] &&
           [ "$5" -eq 1 ] &&
           [ "$6" = "COMPLETED" ]; then
            echo "ECS service stable"
            exit 0
        fi

        sleep 20
    done

    echo "ERROR: ECS deployment did not stabilize within 25 minutes"
    exit 1
'''
                                // Verify final ECS service state
                                def afterJson = sh(
                                    returnStdout: true,
                                    script: '''./aws-cli.sh ecs describe-services \
                                      --cluster "$ECS_CLUSTER" \
                                      --services "$SERVICE_NAME" \
                                      --output json'''
                                ).trim()

                                def afterData = readJSON(
                                    text: afterJson,
                                    returnPojo: true
                                )

                                if (!afterData.services ||
                                    afterData.services.size() != 1) {

                                    error("Cannot verify ECS service ${serviceName}")
                                }

                                def after = afterData.services[0]

                                if (after.status != 'ACTIVE' ||
                                    (after.runningCount as int) !=
                                    (after.desiredCount as int) ||
                                    (after.desiredCount as int) < 1) {

                                    error(
                                        "${serviceName} did not reach desired running count"
                                    )
                                }

                                // Verify deployed task definition image digest
                                def deployedTaskJson = withEnv([
                                    "TASK_ARN=${after.taskDefinition}"
                                ]) {

                                    sh(
                                        returnStdout: true,
                                        script: '''./aws-cli.sh ecs describe-task-definition \
                                          --task-definition "$TASK_ARN" \
                                          --output json'''
                                    ).trim()
                                }

                                def deployedTaskData = readJSON(
                                    text: deployedTaskJson,
                                    returnPojo: true
                                )

                                def deployedContainers =
                                    deployedTaskData.taskDefinition.containerDefinitions

                                if (!deployedContainers.any { c ->
                                    c.name == containerName &&
                                    c.image == targetImage
                                }) {

                                    error(
                                        "ECS image digest verification FAILED: ${serviceName}"
                                    )
                                }

                                echo "ECS deployment VERIFIED: ${serviceName}"
                                echo "Running image: ${targetImage}"
                            }
                            }
                        }
                    }
                }
            }
        }
    }

    // --------------------------------------------------
    // PIPELINE RESULTS
    // --------------------------------------------------

    post {

        success {
            echo """
            ==========================================
            CD SUCCESS
            ==========================================
            CI Build: ${params.CI_BUILD_NUMBER}
            Image Tag: ${params.IMAGE_TAG}
            ECS Cluster: ${env.ECS_CLUSTER}
            Services: backend, frontend
            Status: DEPLOYMENT VERIFIED
            ==========================================
            """
        }

        failure {
            echo 'CD FAILED: Review image verification, ECR, and ECS stages.'
        }
        always {
            archiveArtifacts(
                artifacts: 'ecr-images.properties',
                allowEmptyArchive: true,
                fingerprint: true
            )

            script {
                String baseline = "ecs-baseline-ec2-${env.BUILD_NUMBER}.txt"
                if (fileExists(baseline)) {
                    if (!fileExists('scripts/cleanup-ecs-capacity.sh') ||
                        !fileExists('aws-cli.sh')) {
                        error('Capacity baseline exists but cleanup dependencies are missing; manual AWS cleanup required')
                    }
                    echo 'Starting safe ECS capacity cleanup...'
                    withCredentials([[
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: 'aws-ecr-credentials',
                        accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                        secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                    ]]) {
                        sh '''
                            set -eu
                            bash scripts/cleanup-ecs-capacity.sh
                        '''
                    }
                } else {
                    echo 'No deployment capacity baseline; cleanup not needed.'
                }
            }
        }
    }
}
